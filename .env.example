# ─── AWS / Amazon Bedrock ──────────────────────────────────────────────────────
# Required: credentials for Bedrock (Claude Sonnet 4 is the default Strands model)
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=us-east-1

# Alternative: Bedrock API key (if you use the Bedrock API key flow)
# AWS_BEARER_TOKEN_BEDROCK=your_bedrock_api_key_here

# ─── App Config ────────────────────────────────────────────────────────────────
# Port for the FastAPI server
PORT=8000

# How often the agent runs automatically (in seconds). Default: 3600 (1 hour)
AGENT_RUN_INTERVAL_SECONDS=3600

# Set to "true" to enable verbose agent trace logging
DEBUG=false
